{
  "name": "madar",
  "productName": "Madar",
  "version": "1.7.4",
  "description": "مدار: مهام وتقويم وملاحظات ودفاتر بخط اليد في تطبيق واحد للماك",
  "main": "electron/main.js",
  "license": "MIT",
  "author": {
    "name": "رائد العتيبي (Raeed Alotaibi)",
    "url": "https://github.com/tuwra"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:all": "electron-builder --mac dmg --arm64 --x64",
    "dist:win": "electron-builder --win nsis --x64",
    "test": "node test/merge.test.js"
  },
  "devDependencies": {
    "@capacitor/app": "8.1.0",
    "@capacitor/browser": "8.0.1",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@highlightjs/cdn-assets": "11.11.1",
    "electron": "38.4.0",
    "electron-builder": "26.0.12",
    "jspdf": "3.0.3",
    "katex": "0.16.22",
    "pdfjs-dist": "3.11.174"
  },
  "build": {
    "appId": "app.madar.desktop",
    "productName": "Madar",
    "copyright": "© 2026 رائد العتيبي (Raeed Alotaibi)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "package.json",
      "!src/.claude"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "build/icon.png",
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Madar ${version}",
      "artifactName": "Madar-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Madar-Setup-${version}.${ext}",
      "shortcutName": "Madar",
      "uninstallDisplayName": "Madar"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tuwra",
        "repo": "madar",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tuwra/madar.git"
  },
  "homepage": "https://github.com/tuwra/madar",
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}